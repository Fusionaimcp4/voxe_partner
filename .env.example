# Invite pass for the Friends & Family SAFE section (investor pages).
# Set this and run: node scripts/inject-invite-pass.js
# The value is hashed (SHA-256) at build time; the raw pass is never stored in the built page.
INVESTOR_INVITE_PASS=your_invite_pass_here

# Invite pass for Growth Partner Program pages (separate from investor access).
# Set this and run: node scripts/inject-invite-pass.js
# Do not reuse INVESTOR_INVITE_PASS. Missing/empty fails closed for GPP access.
GROWTH_PARTNER_INVITE_PASS=

# Admin UI password for /admin (separate from invite passes).
ADMIN_PASS=
